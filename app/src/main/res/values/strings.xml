<?xml version="1.0" encoding="utf-8"?>
<!--
  Every Indonesian string the UI displays lives here (epic context, UX-DR14).
  Components take their labels as parameters; what they display unconditionally
  — a numpad key, a validation message, a content description — comes from here
  so no composable carries a literal.
-->
<resources>
    <string name="app_name">Klinik.Net</string>

    <!-- Numpad -->
    <!--
      The prefix is a separate, smaller styled span next to the figure, so the
      numpad cannot reuse formatRupiah's "Rp " prefix verbatim. It still comes
      from here rather than from a literal in the composable.
    -->
    <string name="currency_symbol_rupiah">Rp</string>
    <string name="numpad_key_save">Simpan</string>
    <!--
      Key faces versus announcements. The clear key shows `C` but announces
      "Hapus": a screen reader reading the letter aloud is worse than useless,
      while the spoken word is what the owner actually wants to hear. The
      zero-pad key shows and announces the same `000`, so it needs one string.
    -->
    <string name="numpad_key_clear">Hapus</string>
    <string name="numpad_key_clear_face">C</string>
    <string name="numpad_key_zero_pad">000</string>
    <string name="numpad_key_delete">Hapus digit terakhir</string>
    <!--
      The digit zero. Used both as the zero key's face and as the figure an
      untouched display shows, so an empty panel does not read as broken.
    -->
    <string name="numpad_digit_zero">0</string>
    <string name="numpad_display_label">Jumlah sedang diketik</string>
    <string name="numpad_display_empty">Ketuk angka untuk mulai</string>
    <string name="numpad_rejected_zero">Ditolak. Jumlah harus lebih dari nol — tekan angka untuk mengoreksi.</string>

    <!-- Field -->
    <string name="field_required_error">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <string name="field_invalid_number_error">Hanya angka yang diperbolehkan. Hapus huruf dan coba lagi.</string>
    <string name="field_error_prefix">Galat:</string>

    <!-- Search -->
    <string name="search_hint">Cari</string>
    <string name="search_clear">Hapus pencarian</string>

    <!-- Snackbar -->
    <string name="snackbar_dismiss">Tutup</string>

    <!-- PIN -->
    <string name="pin_grid_label">Kode PIN</string>
    <string name="pin_key_delete">Hapus digit terakhir</string>
    <string name="pin_dot_filled">terisi</string>
    <string name="pin_dot_empty">kosong</string>

    <!-- Logo / iconography -->
    <string name="logo_lockup_description">Klinik.Net</string>
    <string name="logo_mono_description">Klinik.Net</string>

    <!-- Generic control labels used by library components themselves -->
    <string name="action_close">Tutup</string>
    <string name="action_more">Lainnya</string>
    <string name="action_back">Kembali</string>
    <string name="action_edit">Ubah</string>
    <string name="action_delete">Hapus</string>

    <!-- MainActivity placeholder until Story 2.2 replaces it -->
    <string name="home_placeholder_title">Klinik.Net</string>
    <string name="home_placeholder_body">Desain dan komponen inti sudah siap. Layar armada menyusul.</string>

    <!--
      Story 2.2 — Armada (fleet).

      Every string the vehicle screen shows lives here, including the validation
      messages. The repository deliberately returns typed exceptions rather than
      text, so these are the only place the copy for a refusal exists, and a
      screen cannot invent a second wording that says less (epic context: an error
      message must name both the fault and the fix).
    -->
    <!-- Top bar -->
    <string name="kendaraan_title">Armada</string>
    <!--
      The fleet count. A plural would be a second string per count in a language
      whose plural rules differ from the CSS's, and the count is a figure rather
      than a sentence — so it is rendered as "N mobil", which reads correctly in
      both singular and plural Indonesian.
    -->
    <string name="kendaraan_count">%1$d mobil</string>

    <!-- Search and filters -->
    <string name="kendaraan_search_placeholder">Cari plat, merek, atau model</string>
    <!-- Chip labels. `Semua` is the unfiltered state, not an empty one. -->
    <string name="kendaraan_filter_semua">Semua</string>
    <string name="kendaraan_filter_tersedia">Tersedia</string>
    <string name="kendaraan_filter_tersewa">Tersewa</string>
    <string name="kendaraan_filter_servis">Servis</string>

    <!-- List rows -->
    <!--
      The row subtitle is "%1$s %2$d" — brand and year, e.g. "Toyota 2023". Both
      are always present, so there is no variant for a missing year: an empty year
      is a form bug, and hiding it would leave the owner unable to tell two cars
      apart.
    -->
    <string name="kendaraan_row_subtitle">%1$s %2$d</string>
    <!-- Colour, when the owner recorded one: "Warna: Putih". -->
    <string name="kendaraan_row_color">Warna: %1$s</string>
    <!-- Status badges -->
    <string name="kendaraan_status_tersedia">Tersedia</string>
    <string name="kendaraan_status_tersewa">Tersewa</string>
    <string name="kendaraan_status_servis">Servis</string>

    <!-- Empty states -->
    <!--
      The AC names both halves: what is missing, and what to do about it. "Belum
      ada Kendaraan" is the state; the body is the instruction. A bare "no data"
      reads as an error, which the epic context forbids.
    -->
    <string name="kendaraan_empty_title">Belum ada Kendaraan</string>
    <string name="kendaraan_empty_body">Tambahkan mobil pertama untuk mulai mencatat sewa.</string>
    <!--
      A separate empty state for an empty *search result*. It names the query so
      the owner can tell "nothing matched" from "nothing stored" — two situations
      that need opposite actions.
    -->
    <string name="kendaraan_empty_search_title">Tidak ada yang cocok</string>
    <string name="kendaraan_empty_search_body">Tidak ada kendaraan untuk “%1$s”. Coba kata lain atau hapus pencarian.</string>

    <!-- Actions -->
    <string name="kendaraan_add">Tambah Mobil</string>
    <string name="kendaraan_edit">Ubah</string>
    <!-- The row's edit affordance, spoken: names the car it belongs to. -->
    <string name="kendaraan_edit_description">Ubah %1$s</string>

    <!-- Form sheet -->
    <string name="kendaraan_form_title_new">Tambah Mobil</string>
    <string name="kendaraan_form_title_edit">Ubah Mobil</string>
    <string name="kendaraan_field_plate">Nomor plat</string>
    <string name="kendaraan_field_brand">Merek</string>
    <string name="kendaraan_field_model">Model / tipe</string>
    <string name="kendaraan_field_year">Tahun</string>
    <string name="kendaraan_field_color">Warna (opsional)</string>
    <string name="kendaraan_field_rate">Tarif harian</string>
    <string name="kendaraan_field_notes">Catatan (opsional)</string>
    <!-- The rate field carries `Rp` as an affix; the numpad carries its own. -->
    <string name="kendaraan_rate_affix">Rp</string>
    <!-- The manual service marker. A checkbox on the form, not a separate screen. -->
    <string name="kendaraan_form_servis_label">Servis</string>
    <!--
      The second line under the label. It names the one fact the marker carries
      and the one it does not: parking the car moves it off the road, but the
      open contract keeps billing — the marker never stops billing. The
      billing-stopping mechanism is a service exception on the contract (Story
      2.6), not this marker.
    -->
    <string name="kendaraan_form_servis_hint">Mobil sedang di bengkel</string>
    <!--
      Hints, hidden by `KnField` until an error replaces them. Both say what to
      do rather than only what is wrong.
    -->
    <string name="kendaraan_plate_hint">Huruf dan angka, misalnya B 1235 TF</string>
    <string name="kendaraan_rate_hint">Ketik di keypad angka di bawah</string>
    <string name="kendaraan_save">Simpan Kendaraan</string>
    <string name="kendaraan_cancel">Batal</string>

    <!--
      Validation. Each names the fault *and* the fix, per the epic context.

      The blank-plate message is the shared `KnFieldError.Required` one — a blank
      plate is a required field left empty, which is exactly what that enum case
      means, so reusing it keeps one wording for one class of fault instead of
      letting the fleet screen invent a synonym.
    -->
    <string name="kendaraan_error_blank_plate">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <string name="kendaraan_error_blank_brand">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <string name="kendaraan_error_blank_model">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <string name="kendaraan_error_blank_year">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <!--
      Shown instead of a defaulted rate. The prototype's `parseInt(x) || 250000`
      made this message unnecessary by never refusing; this story's rule is that
      no figure is invented, so the owner is told to type one.
    -->
    <string name="kendaraan_error_rate_zero">Tarif harian harus lebih dari nol. Ketik angka di keypad lalu simpan.</string>
    <string name="kendaraan_error_rate_invalid">Hanya angka yang diperbolehkan. Hapus huruf dan coba lagi.</string>

    <!--
      Save refusals, raised as typed exceptions by `VehicleRepository` and given
      their words here. `%1$s` is the plate, so the owner knows which car to fix.
    -->
    <string name="kendaraan_error_duplicate_plate">Plat %1$s sudah dipakai mobil lain. Periksa lagi nomornya.</string>
    <string name="kendaraan_error_invalid_amount">Tarif harian harus lebih dari nol. Ketik angka di keypad lalu simpan.</string>
    <string name="kendaraan_error_has_contract">%1$s masih tersewa. Akhiri sewanya dulu sebelum menghapusnya.</string>
    <string name="kendaraan_error_unexpected">Gagal menyimpan. Coba lagi.</string>
    <!-- Confirmation that a save landed. A snackbar, not a screen state change. -->
    <string name="kendaraan_saved">%1$s tersimpan</string>

    <!--
      Story 2.4 — Penyewa (renters).

      The `penyewa_*` prefix mirrors `kendaraan_*` so a screen's whole copy set is
      findable from its prefix. Same rule as the fleet block above: the repository
      returns typed exceptions rather than text, so these are the only place the
      copy for a refusal exists, and a screen cannot invent a second wording.
    -->
    <!-- Top bar -->
    <string name="penyewa_title">Penyewa</string>
    <!--
      The renter count. Rendered as "N penyewa", which reads correctly in both
      singular and plural Indonesian — the same reasoning as `kendaraan_count`.
    -->
    <string name="penyewa_count">%1$d penyewa</string>

    <!-- Search -->
    <!--
      The three searchable fields, named in the same order the search matches
      them. `kontak darurat` is deliberately absent: an emergency number is not
      something an owner looks a renter up by.
    -->
    <string name="penyewa_search_placeholder">Cari nama, telepon, atau rekening</string>

    <!-- List rows -->
    <!--
      The row subtitle is "%1$s %2$s" — the renter's own number and the emergency
      contact. Both are always present, so there is no variant for a missing one.
    -->
    <string name="penyewa_row_subtitle">%1$s · Darurat %2$s</string>
    <!--
      The account badge. Rendered only when the owner recorded an account, so
      there is no "-"/"kosong" variant — a badge naming absent data would be a
      claim the database cannot support.
    -->
    <string name="penyewa_row_account">Rek %1$s</string>

    <!-- Empty states -->
    <!--
      The AC names both halves: what is missing, and what to do about it. "Belum
      ada Penyewa" is the state; the body is the instruction. A bare "no data"
      reads as an error, which the epic context forbids.
    -->
    <string name="penyewa_empty_title">Belum ada Penyewa</string>
    <string name="penyewa_empty_body">Tambahkan penyewa pertama untuk mulai mencatat sewa.</string>
    <!--
      A separate empty state for an empty *search result*. It names the query so
      the owner can tell "nothing matched" from "nothing stored" — two situations
      that need opposite actions.
    -->
    <string name="penyewa_empty_search_title">Tidak ada yang cocok</string>
    <string name="penyewa_empty_search_body">Tidak ada penyewa untuk “%1$s”. Coba kata lain atau hapus pencarian.</string>

    <!-- Actions -->
    <string name="penyewa_add">Tambah Penyewa</string>
    <string name="penyewa_edit">Ubah</string>
    <!-- The row's edit affordance, spoken: names the person it belongs to. -->
    <string name="penyewa_edit_description">Ubah %1$s</string>

    <!-- Form sheet -->
    <!--
      Exactly four fields, in the order the owner reads them: who, how to reach
      them, who to call in an emergency, where the money lands.
    -->
    <string name="penyewa_field_name">Nama lengkap</string>
    <string name="penyewa_field_phone">Nomor telepon</string>
    <string name="penyewa_field_emergency">Kontak darurat</string>
    <string name="penyewa_field_bank_account">Nomor rekening (opsional)</string>
    <!-- Hints, hidden by `KnField` until an error replaces them. -->
    <string name="penyewa_name_hint">Nama yang dipakai di m-banking</string>
    <string name="penyewa_bank_account_hint">Kosongkan jika dibayar tunai</string>
    <string name="penyewa_save">Simpan Penyewa</string>
    <string name="penyewa_cancel">Batal</string>

    <!--
      Validation and save refusals. Each names the fault *and* the fix, per the
      epic context. The blank-name message is the shared `KnFieldError.Required`
      one — a blank name is a required field left empty, so reusing it keeps one
      wording for one class of fault instead of letting this screen invent a
      synonym.
    -->
    <string name="penyewa_error_blank_name">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <!--
      One wording for both contact fields, because they are the same class of
      fault: a required number the owner did not supply. `Renter` refuses them
      with the same typed exception shape as the name, and the message lands on
      whichever field is actually empty.
    -->
    <string name="penyewa_error_blank_phone">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <string name="penyewa_error_blank_emergency">Wajib diisi. Isi kolom ini lalu kirim ulang.</string>
    <!--
      Raised as a typed exception by `RenterRepository` and given its words here.
      `%1$s` is the stored name, so the owner knows which person to look at —
      after normalisation-free matching it is the exact string already in the
      list, not a re-spelling of what they typed.
    -->
    <string name="penyewa_error_duplicate_name">Nama %1$s sudah dipakai penyewa lain. Periksa lagi namanya.</string>
    <string name="penyewa_error_unexpected">Gagal menyimpan. Coba lagi.</string>
    <!-- Confirmation that a save landed. A snackbar, not a screen state change. -->
    <string name="penyewa_saved">%1$s tersimpan</string>

    <!--
      Story 2.5 — Kontrak (rental contracts).

      The `kontrak_*` prefix mirrors `kendaraan_*` and `penyewa_*` so a screen's
      whole copy set is findable from its prefix. Same rule as the two blocks
      above: the repository returns typed exceptions rather than text, so these are
      the only place the copy for a refusal exists, and a screen cannot invent a
      second wording that says less.
    -->
    <!-- Top bar -->
    <string name="kontrak_title">Kontrak</string>
    <!--
      The contract count. Rendered as "N kontrak", which reads correctly in both
      singular and plural Indonesian — the same reasoning as `kendaraan_count`.
    -->
    <string name="kontrak_count">%1$d kontrak</string>

    <!-- List rows -->
    <!--
      The row subtitle is "%1$s · %2$s" — the renter and the plate, which are the
      two facts that identify a contract. The rate and the start date are the
      trailing and leading values rather than part of this line.
    -->
    <string name="kontrak_row_subtitle">%1$s · %2$s</string>
    <!--
      The schedule badge on a row. `Libur Min` for a six-day week — derived from the
      stored rest day rather than stored beside it, so the two cannot disagree. A
      seven-day contract shows `kontrak_schedule_seven` instead, which is a label
      for the absence of a rest day rather than a second stored value.
    -->
    <string name="kontrak_row_rest_day">Libur %1$s</string>

    <!-- Empty states -->
    <!--
      The AC names both halves: what is missing, and what to do about it. "Belum
      ada Kontrak" is the state; the body is the instruction. A bare "no data"
      reads as an error, which the epic context forbids. There is one empty state
      and not two, because there is no search bar to produce an empty *result*.
    -->
    <string name="kontrak_empty_title">Belum ada Kontrak</string>
    <string name="kontrak_empty_body">Buka kontrak pertama untuk mulai mencatat sewa.</string>

    <!-- Actions -->
    <string name="kontrak_add">Buka Kontrak</string>
    <!--
      The row's affordance, spoken. Names *both* halves of what identifies a rental —
      who and which car — because the plate alone would be read twice (once here and
      once as the subtitle) and the renter never. Story 2.7 owns editing and ending a
      contract, so this names the row rather than promising an action that does not
      exist yet.
    -->
    <string name="kontrak_row_description">Kontrak %1$s dengan %2$s</string>

    <!-- Form sheet -->
    <string name="kontrak_field_renter">Penyewa</string>
    <string name="kontrak_field_vehicle">Mobil</string>
    <string name="kontrak_field_start_date">Tanggal mulai</string>
    <string name="kontrak_field_rate">Tarif harian</string>
    <!-- The rate field carries `Rp` as an affix; the numpad carries its own. -->
    <string name="kontrak_rate_affix">Rp</string>
    <!--
      The schedule picker. Two chips rather than the epic context's `workSchedule`
      string, because `restDay` already expresses both schedules: seven days is a
      null rest day, six days is one. See the story's design note.
    -->
    <string name="kontrak_schedule_label">Jadwal sewa</string>
    <string name="kontrak_schedule_six">6 hari</string>
    <string name="kontrak_schedule_seven">7 hari</string>
    <string name="kontrak_rest_day_label">Hari libur</string>
    <string name="kontrak_rest_day_hint">Satu hari per minggu tanpa tagihan.</string>
    <!--
      The rest-day chips carry no `kontrak_day_*` strings. The seven abbreviations
      live in one place — `Rupiah.kt`'s weekday table, read through
      `DayOfWeek.shortLabel()` — because the `Libur Min` badge and every date on this
      screen render the same seven words, and two lists of them on one screen is how
      a chip and the badge beside it end up naming different days.
    -->

    <!-- Pickers -->
    <string name="kontrak_picker_renter_title">Pilih penyewa</string>
    <string name="kontrak_picker_vehicle_title">Pilih mobil</string>
    <!--
      Per-picker empty copy, naming what is missing *and* where to add it. One
      sentence for both pickers would tell the owner neither which list is empty nor
      what to do about it — and an empty picker is exactly the state where both
      matter, because the fix is on a different screen.
    -->
    <string name="kontrak_picker_empty_renter">Belum ada penyewa. Tambahkan penyewa dulu di layar Penyewa.</string>
    <string name="kontrak_picker_empty_vehicle">Belum ada mobil. Tambahkan mobil dulu di layar Armada.</string>
    <!-- The read-only field's placeholder before anything is picked. -->
    <string name="kontrak_picker_renter_hint">Ketuk untuk memilih penyewa</string>
    <string name="kontrak_picker_vehicle_hint">Ketuk untuk memilih mobil</string>

    <!-- Date picker -->
    <string name="kontrak_date_hint">Ketuk untuk memilih tanggal</string>
    <string name="kontrak_date_confirm">Pilih</string>
    <string name="kontrak_date_dismiss">Batal</string>

    <!-- Hints, hidden by `KnField` until an error replaces them. -->
    <string name="kontrak_rate_hint">Ketik di keypad angka di bawah</string>
    <string name="kontrak_save">Simpan Kontrak</string>
    <string name="kontrak_cancel">Batal</string>

    <!--
      Validation and save refusals. Each names the fault *and* the fix, per the
      epic context.

      The blank-selection messages are the shared required-field wording rather
      than screen-specific synonyms — an unpicked renter *is* a required field left
      empty — which keeps one wording for one class of fault.
    -->
    <string name="kontrak_error_blank_renter">Wajib diisi. Pilih penyewa lalu kirim ulang.</string>
    <string name="kontrak_error_blank_vehicle">Wajib diisi. Pilih mobil lalu kirim ulang.</string>
    <string name="kontrak_error_blank_date">Wajib diisi. Pilih tanggal mulai lalu kirim ulang.</string>
    <string name="kontrak_error_rate_zero">Tarif harian harus lebih dari nol. Ketik angka di keypad lalu simpan.</string>
    <!--
      Raised as a typed exception by `ContractRepository` and given its words here.
      `%1$s` is the blocking plate or person, so the owner knows which one to fix —
      and it is read back from the row that holds the slot rather than echoed from
      the input, so the message names something that exists in the list.
    -->
    <string name="kontrak_error_vehicle_busy">%1$s masih tersewa. Akhiri kontraknya dulu sebelum membuka yang baru.</string>
    <string name="kontrak_error_renter_busy">%1$s masih menyewa mobil lain. Akhiri kontraknya dulu sebelum membuka yang baru.</string>
    <string name="kontrak_error_unexpected">Gagal menyimpan. Coba lagi.</string>
    <!-- Confirmation that a save landed. A snackbar, not a screen state change. -->
    <string name="kontrak_saved">Kontrak %1$s tersimpan</string>
</resources>
