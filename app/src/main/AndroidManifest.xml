<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions declared. In particular no storage permission: backup
     export goes through the Storage Access Framework, which grants per-file
     access without one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mark"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KlinikNet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.KlinikNet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>