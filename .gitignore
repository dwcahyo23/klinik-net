# ── BMAD ───────────────────────────────────────────────
# Working state only. The planning documents themselves ARE tracked —
# they hold decisions that can't be re-derived from the code, and losing
# them means losing the reasoning behind every architectural choice.
_bmad-output/**/.memlog.md
_bmad-output/**/review-*.md
_bmad-output/**/reconcile-*.md
_bmad-output/**/.working/

# Installer-managed + per-user answers
_bmad/config.user.toml
_bmad/custom/*.user.toml

# Rendered skill output (already self-ignoring, kept explicit)
_bmad/render/

# ── Gradle ─────────────────────────────────────────────
.gradle/
build/
local.properties

# ── Android / Kotlin ───────────────────────────────────
.kotlin/
.externalNativeBuild/
.cxx/
captures/

*.apk
*.aab
*.dex

# ── Secrets — never commit ─────────────────────────────
*.jks
*.keystore
keystore.properties
signing.properties
google-services.json

# ── IDE ────────────────────────────────────────────────
*.iml
.idea/
.idea/**
.vscode/

# ── Tool scratch ───────────────────────────────────────
node_modules/
.playwright-mcp/
.playwright/

# ── OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini